# ===== waywell 프론트 환경변수 =====
# frontend/.env.development (로컬) 로 복사해 채운다. (.gitignore — 커밋 금지)
# cp frontend/.env.example frontend/.env.development
#
# ★ 배포(빌드)에는 .env.development 가 쓰이지 않는다.
#   `npm run build` 는 production 모드로 돌아 .env.production 만 읽으므로,
#   배포 서버에는 .env.production 을 따로 만들어야 한다.
#   빠뜨리면 VITE_* 가 undefined 로 번들에 박혀 배포판에서만 지도와
#   카카오 로그인이 조용히 죽는다(로컬은 멀쩡해서 원인 찾기 어렵다).
#   cp frontend/.env.example frontend/.env.production

# 목업 모드: true면 일부 화면이 public/mock/*.json 사용(실 API 없이 UI 확인). 실연동은 false.
VITE_USE_MOCK=false

# 카카오맵 JS SDK 키 (지도 표시). 도메인 제한이라 프론트 노출 OK.
# 카카오 콘솔 > 내 애플리케이션 > 앱 키 > 'JavaScript 키'
VITE_KAKAO_JS_KEY=

# 카카오 로그인(인가 코드 흐름)의 client_id = REST API 키.
# ★ 백엔드 KAKAO_REST_API_KEY 와 '같은 앱'의 REST 키여야 로그인 성공.
# 카카오 콘솔 > 플랫폼 Web '사이트 도메인' 등록 + 카카오 로그인 'Redirect URI'
#   (예: http://localhost:5173/auth/kakao/callback) 등록 필수.
VITE_KAKAO_REST_KEY=
