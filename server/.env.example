# ===== waywell 서버 환경변수 =====
# 이 파일을 server/.env 로 복사해 값을 채운다.  cp server/.env.example server/.env
# .env 는 커밋 금지(.gitignore). 값 없이 비워두면 해당 기능만 비활성/에러.

# --- Django ---
SECRET_KEY=
# ↑ 생성: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True
# 배포 도메인(콤마 구분). 로컬만 쓰면 그대로 둬도 됨.
ALLOWED_HOSTS=localhost,127.0.0.1
# 프론트 오리진(콤마 구분) — CORS 허용
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://waywell.testgogo.site

# ===== data.go.kr (공공데이터포털) =====
# ★중요: 한 계정에서 발급한 '일반 인증키(Encoding)' 하나로 아래 서비스들을 각각
#   '활용신청'하면, 같은 키를 여러 항목에 그대로 넣어도 된다.
#   서비스별 신청/승인이 안 된 키를 쓰면 그 항목만 null/에러가 난다.
#   (동료들이 겪은 '자외선·미세먼지 null'의 주원인 = 아래 서비스 미신청 또는 키 미설정)

# 날씨(초단기실황): VilageFcstInfoService_2.0 활용신청
KMA_API_KEY=
# 자외선지수: LivingWthrIdxServiceV5 활용신청  ← 이 키가 없으면 자외선이 항상 null
KMA_UV_API_KEY=
# 미세먼지: ArpltnInforInqireSvc(실시간) + MsrstnInfoInqireSvc(근접 측정소) 둘 다 신청
AIRKOREA_API_KEY=
# 버스 도착/정류소: ArvlInfoInqireService + BusSttnInfoInqireService 신청
TAGO_API_KEY=

# ===== 카카오 (developers.kakao.com) =====
# REST API 키 — 장소검색·좌표변환·카카오 로그인 토큰교환에 사용.
# ★ 프론트의 VITE_KAKAO_REST_KEY 와 '같은 앱'의 REST 키여야 로그인이 된다.
KAKAO_REST_API_KEY=
# 카카오 콘솔 > 보안 > 'Client Secret 사용함'을 켠 경우에만 필수. 아니면 비워둔다.
KAKAO_CLIENT_SECRET=

# ===== Tmap (openapi.sk.com) =====
# 대중교통(주 경로) + 보행자(도보 후보/실보행로) 경로. 두 제품 모두 구독 필요.
# SK 오픈API > 마이페이지 > 앱 appKey
TMAP_APP_KEY=

# ===== ODsay (odsay.com) — 대중교통 경로 폴백 =====
ODSAY_API_KEY=
# ODsay 키는 등록 도메인(Referer) 검증 → 콘솔에 등록한 URL과 일치해야 함.
ODSAY_REFERER=http://localhost:5173

# ===== (선택) 레이트리밋 오버라이드 =====
# THROTTLE_ANON=120/min
# THROTTLE_USER=240/min

# 참고: DB는 SQLite(db.sqlite3) 고정 → 별도 DB 설정 불필요.
#       JWT는 SECRET_KEY로 서명 → 별도 JWT 키 불필요.
#       카카오 로그인은 콘솔에 Redirect URI(예: http://localhost:5173/auth/kakao/callback) 등록 필수.
